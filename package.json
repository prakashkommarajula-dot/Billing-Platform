{
  "name": "invoice-generation-billing-platform",
  "version": "1.0.0",
  "description": "Full-stack Invoice Generation and Business Billing Management Platform",
  "scripts": {
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "start": "npm run start --prefix backend",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "k8s:apply": "kubectl apply -k k8s/",
    "k8s:delete": "kubectl delete -k k8s/",
    "k8s:status": "kubectl get all,pvc -n billflow",
    "k8s:logs:backend": "kubectl logs -l app=backend -n billflow -f",
    "k8s:logs:frontend": "kubectl logs -l app=frontend -n billflow -f"
  },
  "keywords": [
    "invoice",
    "billing",
    "accounting",
    "react",
    "express",
    "mongodb",
    "docker",
    "devops"
  ],
  "author": "B.Tech DevOps and Full Stack Development",
  "license": "ISC"
}
